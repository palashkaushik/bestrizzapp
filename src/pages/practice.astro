---
import Layout from '../layouts/Layout.astro';
import { PERSONAS, scoreReply } from '../data/personas';
---

<Layout>
  <main>
    <p class="eyebrow">AI practice · mock v1</p>
    <h1>Reps before reality</h1>
    <label>Persona
      <select id="p">{PERSONAS.map((p) => (<option value={p.id}>{p.name} — {p.mood}</option>))}</select>
    </label>
    <div id="chat" class="chat"></div>
    <form id="f"><input id="t" placeholder="Your reply…" autocomplete="off" /><button>Send</button></form>
    <div id="score" class="score" hidden></div>
  </main>
</Layout>

<script define:vars={{ PERSONAS }}>
  import { scoreReply } from '../data/personas';
  const chat = document.getElementById('chat');
  const sel = document.getElementById('p');
  const say = (who, text) => { const d = document.createElement('p'); d.innerHTML = `<strong>${who}:</strong> ${text}`; chat.append(d); };
  const persona = () => PERSONAS.find((p) => p.id === sel.value);
  say('Coach', persona().opener);
  sel.addEventListener('change', () => { chat.innerHTML = ''; say('Coach', persona().opener); });
  document.getElementById('f').addEventListener('submit', (e) => {
    e.preventDefault();
    const input = document.getElementById('t');
    const s = scoreReply(input.value);
    say('You', input.value);
    say(persona().name, s.vibe > 18 ? 'Haha ok, that landed. Where would we go?' : 'Hmm. Try one specific detail + one question.');
    const el = document.getElementById('score');
    el.hidden = false;
    el.textContent = `Q ${s.q} · Balance ${s.balance} · Follow-up ${s.follow} · Vibe ${s.vibe} — saved to practice_sessions shape.`;
    input.value = '';
  });
</script>

<style>main{background:#0B0D10;color:#F5F7FA;min-height:100vh;padding:32px 20px;max-width:720px;margin:0 auto;font-family:Inter,system-ui,sans-serif;} .eyebrow{color:#9AA4B2;font-size:12px;letter-spacing:.08em;text-transform:uppercase;} select,input{background:#0B0D10;border:1px solid #262B33;color:#F5F7FA;border-radius:10px;padding:10px;} form{display:flex;gap:8px;margin-top:10px;} button{background:#FF3B30;color:#fff;border:0;border-radius:999px;padding:10px 18px;font-weight:700;} .chat{background:#15181D;border:1px solid #262B33;border-radius:14px;padding:14px;min-height:160px;display:flex;flex-direction:column;gap:8px;margin-top:10px;} .score{margin-top:10px;color:#FACC15;border:1px solid #FACC15;border-radius:14px;padding:12px;}</style>
