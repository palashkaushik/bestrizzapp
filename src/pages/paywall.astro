---
import Layout from '../layouts/Layout.astro';
// Paste your Stripe Payment Link when ready. Until then the button scrolls to value props.
const STRIPE_LINK = '';
const rows = [
  ['Daily action missions', '✓', '✓'],
  ['Interactive video lessons', '3 starter', 'Unlimited'],
  ['AI conversation practice', '—', '✓'],
  ['Confidence Radar analytics', 'Basic', 'Full 10-axis'],
  ['Streaks + XP', '✓', '✓'],
];
---

<Layout>
  <main>
    <p class="eyebrow">Go unlimited</p>
    <h1>God-level costs less than one bad date.</h1>
    <table>
      <thead><tr><th></th><th>Free</th><th>Pro</th></tr></thead>
      <tbody>{rows.map((r) => (<tr><td>{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td></tr>))}</tbody>
    </table>
    <a class="cta" href={STRIPE_LINK || '/missions'}>{STRIPE_LINK ? 'Unlock Pro →' : 'Start free — paywall arms on launch →'}</a>
    <p class="fine">Stripe Payment Links checkout. Cancel anytime. Rejection still earns double XP either way.</p>
  </main>
</Layout>

<style>main{background:#0B0D10;color:#F5F7FA;min-height:100vh;padding:48px 20px 64px;max-width:560px;margin:0 auto;font-family:Inter,system-ui,sans-serif;} .eyebrow{color:#9AA4B2;font-size:12px;letter-spacing:.08em;text-transform:uppercase;} h1{font-size:30px;} table{width:100%;border-collapse:collapse;margin:18px 0;} th,td{border:1px solid #262B33;padding:10px;text-align:left;font-size:14px;} th:last-child,td:last-child{color:#FACC15;} .cta{display:block;text-align:center;background:#FF3B30;color:#fff;text-decoration:none;font-weight:700;border-radius:999px;padding:14px;margin-top:6px;} .fine{color:#9AA4B2;font-size:12.5px;text-align:center;}</style>
